{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "dev": "pnpm install --frozen-lockfile=false && PORT=8080 pnpm --filter @workspace/aethex run dev",
    "build": "pnpm install --frozen-lockfile=false && pnpm --filter @workspace/aethex run build",
    "build:dev": "pnpm install --frozen-lockfile=false && pnpm --filter @workspace/aethex run build",
    "start": "PORT=8080 pnpm --filter @workspace/aethex run serve",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm --filter @workspace/aethex run typecheck"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "path-to-regexp": "8.4.0",
      "picomatch@^2": "2.3.2",
      "picomatch@^4": "4.0.4",
      "brace-expansion": "2.0.3",
      "yaml": "2.8.3",
      "esbuild@0.18.20": "0.25.0",
      "lodash": ">=4.18.0",
      "lodash-es": ">=4.18.0",
      "serialize-javascript": ">=7.0.3",
      "vite": ">=7.3.0"
    }
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
