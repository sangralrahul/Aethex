{
  "name": "aethex",
  // Keep secrets and variables set in the dashboard when deploying.
  "keep_vars": true,
  // Serves the site from ./dist and runs the AI endpoints in worker/index.ts.
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "build": { "command": "pnpm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/cadus/*", "/downloads", "/downloads/"]
  },
  // Accounts, sessions, Cadus profiles and store carts live in Cloudflare D1.
  // One-time setup (see migrations/0001_accounts.sql):
  //   1. npx wrangler d1 create aethex              (prints a database_id)
  //   2. paste the id below
  //   3. npx wrangler d1 migrations apply aethex --remote
  // Until the id is pasted, deploys fail and the previous version stays live.
  "d1_databases": [{ "binding": "DB", "database_name": "aethex", "database_id": "d0cf73ca-7f81-4399-b616-97a4f27c46d8", "migrations_dir": "migrations" }],
  // The Cadus desktop installers (uploaded with desktop\upload-r2.cmd).
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "aethex-downloads" }],
  // Workers AI (Whisper) for voice typing in the Cadus desktop app and in browsers without
  // their own speech service (worker/transcribe.ts). No key needed; billed by Workers AI.
  "ai": { "binding": "AI" },
  // ElevenLabs (optional): natural voices, Scribe, patient audio and podcasts (worker/voice.ts).
  //   npx wrangler secret put ELEVENLABS_API_KEY
  // Optional variables: ELEVENLABS_VOICE (default voice id), ELEVENLABS_DAILY_SPEAK (speak calls a day
  // per signed-in account, default 400), ELEVENLABS_DAILY_STT (default 300), and model overrides.
  // Store cart reminders and clean-up, every hour.
  "triggers": { "crons": ["17 * * * *"] },
  // The site and its subdomains. Custom domains get their DNS records and
  // certificates from Cloudflare automatically on deploy.
  "routes": [
    { "pattern": "aethex.in", "custom_domain": true },
    { "pattern": "www.aethex.in", "custom_domain": true },
    { "pattern": "cadus.aethex.in", "custom_domain": true },
    { "pattern": "auth.aethex.in", "custom_domain": true },
    { "pattern": "login.aethex.in", "custom_domain": true },
    { "pattern": "downloads.aethex.in", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}