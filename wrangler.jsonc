{
  "name": "aethex",
  // Serves the site from ./dist and runs the AI endpoints in worker/index.ts.
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "build": { "command": "pnpm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/fn/*", "/api/health"]
  },
  "observability": { "enabled": true }
}